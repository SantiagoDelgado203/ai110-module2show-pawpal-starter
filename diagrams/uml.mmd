classDiagram
    %% PawPal+ draft UML (Phase 1). Will be revisited in Phase 6.

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) bool
        +get_pet(name: str) Pet
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(description: str) bool
        +get_pending_tasks() list~Task~
        +task_count() int
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete() None
        +mark_incomplete() None
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~tuple~
        +get_todays_schedule() list~tuple~
        +format_schedule() str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : reads pets/tasks from
